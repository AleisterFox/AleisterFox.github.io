<file path="script.js">
const downloadButton = document.querySelectorAll('.download-cv');
const socialsButton = document.querySelector('.filled');
const touchButton = document.getElementById('touch');
const inTouch = document.getElementById('touch').innerText;
const inTouchWeight = touchButton.style.fontWeight;
const burguerMenu = document.querySelector('.burguer');
const menu = document.querySelector('.menu');

downloadButton.forEach(download => {
    download.addEventListener('click', () => {
        const fileUrl = './cv.pdf';
        const fileName = 'cv.pdf';
      
        fetch(fileUrl)
          .then(response => response.blob())
          .then(blob => {
            // Create a temporary anchor element
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = fileName;
      
            // Programmatically trigger the download
            a.click();
      
            // Clean up
            URL.revokeObjectURL(a.href);
            a.remove();
          });
      });
});

socialsButton.addEventListener('click', () => {
  let socialMedia = document.querySelector('.social__media');
  if (socialMedia.classList.contains('hide')) {
    socialMedia.style.zIndex = '-1';
    socialMedia.classList.remove ('hide');
    socialMedia.style.animation = 'appear 0.5s linear';
    setTimeout(() => {
      socialMedia.style.zIndex = '1';
    }, 490);
  } else {
    socialMedia.style.zIndex = '-1';
    socialMedia.style.animation = 'dissappear 0.5s linear';
    setTimeout(() => {
      socialMedia.classList.add ('hide');
    }, 490);
  }
});


touchButton.addEventListener('mouseover', () => {
  touchButton.innerText = 'Whatsapp me';
  touchButton.style.fontWeight = '800';
});

touchButton.addEventListener('mouseout', () => {
  touchButton.innerText = inTouch;
  touchButton.style.fontWeight = inTouchWeight;
});

burguerMenu.addEventListener('click', () => {
  let displayMenu = menu.style.display;

  if (displayMenu === 'none') {
    menu.style.display = 'block';
    menu.style.animation = 'menuappear 0.5s ease-in-out'
    
  } else {
    menu.style.animation = 'menudisappear 0.5s ease-in-out'
    setTimeout(() => {
      menu.style.display = 'none';
    }, 490);
  }
});
</file>

<file path="style.css">
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-family: nunito, sans-serif;
    font-size: 62.5%;
    color: white;
    scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  background-color: rgb(0, 0, 0);
}

.wow {
    animation-duration: 2s !important;
    animation-delay: 0.5s !important;
}

header {
  background-color: rgba(0, 0, 0,0.9);
  padding: 10px;
  padding-left: 4rem;
  position: fixed;
  width: 100vw;
  height: 70px;
  z-index: 1000;
}
.burguer {
    display: none;
}
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo img {
  max-height: 6rem;
}

.menu ul {
  list-style-type: none;
  margin: 0;
  margin-left: 1rem;
  padding: 0;
  display: flex;
}

.menu ul li {
  margin-right: 20px;
}

.menu ul li a {
  color: #fff;
  text-decoration: none;
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: 3px;
}

.download-cv, .contact-button, .social-button {
  margin-left: auto;
  margin-right: 2.5rem;
  font-size: 1.6rem;
  cursor: pointer;
}

.outline-button {
  display: inline-block;
  padding: 10px 20px;
  border: 2px solid #fff;
  color: #fff;
  text-decoration: none;
}

.outline-button:hover {
  background-color: #fff;
  color: #333;
}

/* Hero Section */

#hero {
    color: white;
    position: relative;
    padding-left: 5rem;
    display: flex;
    height: 100vh;
}

#hero .container {
    position: absolute;
    top: 15rem;
}

h1 {
    font-size: 2.5vw;
    color: rgba(224, 124, 30, 0.7);
    margin: 3rem 0;
    animation: down_appear 2s ease-in-out;
}

#hero .bg {
    position: absolute;
    width: auto;
    right: 15rem;
    animation: bg_appear 2s ease-in-out;
}

#hero h2 {
    font-size: 6vw;
    font-weight: 500;
    max-width: 70rem;
    animation: name_appear 2s ease-in-out;
}

@keyframes name_appear {
    from {
        transform: translateX(-100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes down_appear {
    from {
        transform: translateY(200%);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes bg_appear  {
    from {
        transform: translateX(100%) scale(0.5);
        opacity: 0;
    }
    to {
        transform: translateX(0) scale(1);
        opacity: 1;
    }
}

#hero .greetings {
    font-size: 1.8rem;
    display: flex;
    justify-content: space-between;
    width: 40vw;
    animation: down_appear 2s ease-in-out;
}

#hero .greetings .download-cv {
    width: 30%;
}

#hero h3 {
    width: 70%;
    font-size: 1.4vw;
}

#hero img {
    width: 45vw;
}

#hero .container {
    z-index: 10;
}

/*TECHS*/

.stack {
    color: #fff;
    padding-left: 5rem;
    padding-right: 5rem;
    margin-top: 5rem;
}

.stack h3 {
    font-size: 3rem;
    text-align: center;
    color: rgba(224, 124, 30, 0.7);
}

.stack h4 {
    font-size: 2rem;
    text-align: center;
    font-weight: 300;
    
}

.stack__logos {
    display: flex;
    width: 80%;
    margin: 0 auto;
    margin-top: 3rem;
    height: 10rem;
    justify-content: space-between;
}

.stack__logos figure {
    height: 100%;
    width: calc(100%/5);
    border: 2px solid white;
    border-right: 1px solid white;
    display: flex;
    justify-content: center;
    align-items: center;
}

.stack__logos figure:last-child {
    border-right: 2px solid white;
}

.stack__logos img {
    filter: invert(100%);
    height: 80%;
}

/* About Me */

.about-me {
    padding: 0 5rem;
    margin-top: 15rem;
}

.about-me h2 {
    font-size: 4rem;
    margin-bottom: 3rem;
}

.about-me p {
    font-size: 2rem;
    font-weight: 300;
    width: 50%;
    position: relative;
    text-align: justify;
}

.about-me p::after {
    content: " ";
    display: block;
    background-color: rgba(224, 124, 30, 0.5);
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 40%;
    z-index: -1;
}

/* portfolio */

#portfolio {
    margin-top: 10rem;
    padding: 0rem;
    padding: 0 5rem;
}

#portfolio h2 {
    font-size: 4rem;
    margin-bottom: 2rem;
}

#portfolio h3 {
    font-size: 2rem;
    font-weight: 300;
    margin-bottom: 4rem;
    color: rgba(224, 124, 30, 0.7); 
}

#projects {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    row-gap: 5rem;
    width: 100%;
}

.project {
    min-width: 30%;
    width: 30rem;
    max-width: 100%;
    border: 4px solid white;
    position: relative;
    margin: 0rem;
    transition: all 0.2s ease-in-out;
}

.project figure {
    width: 100%;
    height: 100%;
}

.project img {
    width: 100%;
    height: 100%;
}

.project .description {
    color: white;
    text-decoration: none;
    text-align: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: none;
}

.project .description h4 {
    font-size: 3.5rem;
    font-weight: 700;
}

.project .description p {
    font-size: 2rem;
    width: 80%;
    margin: 0 auto;
    margin-bottom: 1rem;
    line-height: 2rem;
}

.project .description .logos{
    width: 100%;
    height: 5%;
    filter: invert(100%);
    display: flex;
    justify-content: space-around;
}

.project .logos>img {
    width: 10%;
}

.project:hover figure img {
    filter: grayscale(100%) brightness(40%);
}

.project:hover .description {
    display: inherit;
}

.project:hover {
    scale: 1.1;
}

/* Contact */

#contact {
    margin-top: 15rem;
    padding: 0 5rem;
}

#contact h2 {
    font-size: 6rem;
    letter-spacing: 5px;
    width: 50%;
    text-align: center;
    margin: 0 auto;
    margin-bottom: 2rem;
}

.colab {
    color: rgba(224, 124, 30, 0.7);
}

#contact .buttons {
    display: flex;
    justify-content: center;
    width: 50%;
    margin: 0 auto;
}

#contact .buttons>div {
    margin-left: 0;
}

.filled {
    background-color: rgba(224, 124, 30, 0.7);
    border:none;
    z-index: 10;
}

.social-button {
    position: relative;
}

.filled:hover {
    background-color: rgba(224, 124, 30, 1);
    color: white;
}

.social__media {
    display: flex;
    flex-direction: row;
    position: absolute;
    top: 0;
    right: -170%;
    z-index: 1;
}

.social__media img {
    filter: invert(100%);
    width: 3.5rem;
    margin: 0 1rem;
}

.social__media img:hover {
    scale: 1.2;
}

.hide {
    display: none;
}

/* footer */

footer {
    height: 12vh;
    margin-top: 10rem;
    padding: 0 5rem;
}

footer hr {
    border: none;
    height: 1px;
    color: rgba(211, 211, 211, 0.5);
    background-color: rgba(211, 211, 211, 0.5);
}

footer .container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 1.6rem;
    margin-top: 1vh;
}

footer .container div:first-child {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 30vw;
}

footer .container div:first-child .copy {
    padding-top: 4vh;
    color: rgba(211, 211, 211, 0.5);
    padding-bottom: 1rem;
}

footer ul {
    list-style: none;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
}

footer ul a {
    text-decoration: none;
    color: white;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateX(-50%);
        z-index: -1 !important;
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes dissappear {
    from {
        opacity: 1;
        transform: translateX(0);
    }

    to {
        opacity: 0;
        transform: translateX(-50%);
    }
}

@media (max-width: 768px) {
    .download-cv {
        margin-right: 6rem;
    }
    #hero {
        padding: 0 5rem;
        height: 55vh;
    }
    #hero .bg {
        width: 70%;
        right: -5rem;
    }
    #hero img {
        width: 100%;
    }
    #hero h2 {
        font-size: 10vw;
        max-width: 60vw;
    }
    h1 {
        font-size: 5vw;
        margin: 2rem 0;
    }

    #hero .greetings {
        width: 70vw;
        font-size: 2.5vw;
        flex-direction: row;
    }

    #hero h3 {
        width: 60%;
        font-size: 2.5vw;
    }

    .stack h3 {
        font-size: 5vw;
    }

    .stack h4 {
        font-size: 2.5vw;
    }

    .stack__logos {
        width: 100%;
    }

    .about-me {
        margin-top: 10rem;
    }
    .about-me h2 {
        font-size: 5vw;
    }
    .about-me p {
        width: 70%;
    }

    #portfolio h2 {
        font-size: 5vw;
    }

    #portfolio h3 {
        font-size: 2.5vw;
    }
    #contact {
        margin-top: 10rem;
    }
    #contact h2 {
        font-size: 5vw;
    }

    footer .container div:first-child {
        width: 50vw;
    }

    footer .container div:first-child .copy {
        padding-top: 1rem;
    }
}

@media (max-width: 425px) {
    h3 {
        font-size: 8vw !important;
    }
    h4 {
        font-size: 4vw !important;
    }
    header {
        padding: 0 1rem;
    }
    .navbar {
        position: relative;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
    .menu {
        background-color: rgba(0, 0, 0,0.9);
        height: 15rem;
        width: 100%;
        position: absolute;
        top: 70px;
        left: -1rem;
        display: none;
    }
    .menu ul {
        flex-direction: column;
        height: 100%;
        justify-content: space-around;
        text-align: center;
    }
    .burguer {
        height: 100%;
        display: block;
        width: 3rem;
        margin-right: 2rem;
    }
    .burguer img {
        width: 100%;
        filter: invert(100%);
    }

    #hero {
        padding: 0 2rem;
        overflow-x: hidden;
        height: 45vh;
    }

    #hero .container {
        top: 10rem;
    }
    #hero .bg {
        right: -5rem;
        top: 5rem;
    }
    #hero h2 {
        font-size: 12vw;
        max-width: 70vw;
    }
    #hero h1 {
        font-size: 6vw;
    }
    #hero .greetings {
        width: 100%;
    }

    #hero h3 {
        font-size: 3.5vw !important;
        width: 50%;
    }
    #hero .greetings .download-cv {
        margin-left: 1rem;
        margin-right: 3rem;
        width: 40%;
    }
    #hero .outline-button {
        width: 100%;
        font-size: 1.5rem;
        padding: 0.5rem;
        text-align: center;
    }

    .stack {
        padding: 0 2rem;
        margin-top: 10rem;
    }

    .stack__logos img {
        height: 45%;
    }

    .about-me {
        padding: 0 2rem;
    }

    .about-me h2 {
        font-size: 8vw;
    }
    .about-me p {
        width: 100%;
    }
    .about-me p::after {
        height: 110%;
        width: 70%;
        top: -5%;
        left: 30%;
    }

    #portfolio {
        padding: 0 2rem;
    }
    #portfolio h2 {
        font-size: 8vw;
        margin-bottom: 1rem;
        text-align: center;
    }

    #portfolio h3 {
        font-size: 4vw !important;
        text-align: center;
    }
    #projects {
        row-gap: 2rem;
    }
    .project {
        width: 35rem;
    }

    #contact {
        padding: 0 2rem;
    }
    #contact h2 {
        width: 100%;
        font-size: 8vw;
    }

    #contact .buttons {
        width: 100%;
    }

    .social__media {
        transform: translateX(-105%) translateY(150%);
    }

    footer {
        padding: 0 2rem;
    }
    footer .container div:first-child {
        width: 60vw;
        text-align: justify;
        font-size: 1.2rem;
    }

    footer ul a {
        font-size: 1.2rem;
    }

    @keyframes appear {
        from {
            opacity: 0;
            transform: translateY(0) translateX(-105%) scale(0.5);
            z-index: -1 !important;
        }
    
        to {
            opacity: 1;
            transform: translateY(150%) translateX(-105%) scale(1);
        }
    }
    
    @keyframes dissappear {
        from {
            opacity: 1;
            transform: translateY(150%) translateX(-105%) scale(1);
        }
    
        to {
            opacity: 0;
            transform: translateY(0) translateX(-105%) scale(0.5);
        }
    }


    @keyframes menuappear {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes menudisappear {
        
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }

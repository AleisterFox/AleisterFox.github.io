    <script>
      function getToken() {
        fetch("https://translator-ovb3.onrender.com/token")
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            return response.json();
          })
          .then((data) => {
            console.log("Token:", data.token);
          })
          .catch((error) => {
            console.error("Error:", error);
          });
      }

      // Llamar a la función cada 15 minutos
      setInterval(() => {
        getToken();
      }, 15 * 60 * 1000); // 15 minutos en milisegundos

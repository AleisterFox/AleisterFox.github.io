/* girar */
@-webkit-keyframes girar {
  0% {
	-webkit-transform:rotate(0deg); 
	transform:rotate(0deg);
    visibility: visible;
  }
  100% {
    -webkit-transform:rotate(-360deg); 
	transform:rotate(-360deg);
    visibility: visible;
  }
}

@keyframes girar {
  0% {
    -webkit-transform: translateY(9px);
    transform: translateY(9px);
    visibility: visible;
  }
  100% {
    -webkit-transform: translateY(9px);
    -ms-transform: translateY(9px);
    transform: translateY(9px);
  }
}

.girar {
  -webkit-animation-name: girar;
  animation-name: girar;
  -webkit-animation-duration:6s;
  animation-duration:        6s;
}

/* trazo */
@-webkit-keyframes trazo {
  0% {
	stroke-dasharray: 4800;
	stroke-dashoffset:4800;
	animation: dash linear forwards;
  }
  100% {
    stroke-dashoffset: 0;
  }
}

@keyframes trazo {
  0% {
    stroke-dasharray: 4800;
	stroke-dashoffset:4800;
	animation: linear forwards;
  }
  100% {
    stroke-dashoffset: 0;
  }
}

.trazo {
  -webkit-animation-name: trazo;
  animation-name: trazo;
  -webkit-animation-duration:3s;
  animation-duration:        3s;
}

/* strokeFadeIn */
@-webkit-keyframes strokeFadeIn {
	from {
		opacity:0;
	}
	to {
	    opacity:1;
	}
}
@-moz-keyframes strokeFadeIn {
	from {
		opacity:0;
	}
	to {
		opacity:1;
	}
}
@keyframes strokeFadeIn {
	from {
		opacity:0;
	}
	to {
		opacity:1;
	}
}

.strokeFadeIn {
	opacity:0;
	-webkit-animation:strokeFadeIn ease-in 1;
	-moz-animation:   strokeFadeIn ease-in 1;
	animation:        strokeFadeIn ease-in 1;

	-webkit-animation-fill-mode:forwards;
	-moz-animation-fill-mode:   forwards;
	animation-fill-mode:        forwards;

	-webkit-animation-duration:1.8s;
	-moz-animation-duration:   1.8s;
	animation-duration:        1.8s;
	
	animation-delay:1.8s;
}

@-moz-keyframes show {
  0% {
	  -moz-clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  }
  100% {
	  -moz-clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }
}
@-webkit-keyframes show {
  0% {
	  -webkit-clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  }
  100% {
	  -webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }
}
@-o-keyframes show {
  0% {
	  -o-clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  }
  100% {
	  -o-clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }
}
@keyframes show {
  0% {
	  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  }
  100% {
	  clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }
}

.show {
  -webkit-animation-name: show;
  animation-name: show;
}
